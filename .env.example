# PostgreSQL connection string. For Vercel deployment use Neon / Vercel Postgres.
# Pooled connection (used at runtime):
DATABASE_URL="postgresql://user:password@host:5432/school_management?schema=public"
# Direct (non-pooled) connection, used for migrations:
DIRECT_URL="postgresql://user:password@host:5432/school_management?schema=public"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
